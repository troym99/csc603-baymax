PORT=3000
# Shared AWS RDS database. Never commit .env
DATABASE_URL=postgres://USER:PASSWORD@YOUR-ENDPOINT.rds.amazonaws.com:5432/appdb
DATABASE_SSL=true
# Long random string used to sign login cookies. Same value for the whole team.
JWT_SECRET=change-me
# Set to true once the site is served over HTTPS
COOKIE_SECURE=false
